    <string name="about_section_origin">Pochodzenie oprogramowania</string>
    <string name="about_content_origin_1">Ta aplikacja jest forkiem projektu open source Lemuroid, dystrybuowanego na licencji GPL-3.0.</string>
    <string name="about_content_origin_2">Dodano funkcje eksploracji publicznie dostępnych treści na Archive.org i darmowych gier homebrew z itch.io.</string>
