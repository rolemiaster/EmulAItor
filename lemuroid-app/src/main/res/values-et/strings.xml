    <string name="about_section_origin">Tarkvara päritolu</string>
    <string name="about_content_origin_1">See rakendus on avatud lähtekoodiga Lemuroid projekti kahvel, levitatakse GPL-3.0 litsentsi alusel.</string>
    <string name="about_content_origin_2">Lisatud on avalikult saadaval oleva sisu uurimisfunktsioonid Archive.org-ist ja tasuta kodumängud itch.io-st.</string>
    <string name="about_section_source">Allikakood</string>
    <string name="about_content_source">Selle muudetud versiooni allikakood on saadaval GPL-3.0 litsentsi alusel.</string>
